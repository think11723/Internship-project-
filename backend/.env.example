# Project metadata (read by app.core.config.Settings)
PROJECT_NAME=FundFlow AI
PROJECT_DESCRIPTION=AI Career Intelligence Platform
VERSION=0.1.0

# API configuration
API_V1_PREFIX=/api

# CORS — origins allowed to call the API in development.
# In production, replace with the deployed frontend origin.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database — single SQLite file used for the Resume table.
DATABASE_URL=sqlite:///./fundflow.db

# --- LLM provider ---
# The application talks to OpenRouter (an OpenAI-compatible API) via
# the official openai Python SDK. These three variables are required
# for cover-letter generation to function. Without them the
# orchestrator falls back to a null cover_letter (graceful degradation).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick any currently-available model from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# LLM provider selector — declared for future flexibility. The current
# orchestrator always routes through OpenRouter; this field is not yet
# branched on but its presence avoids the "Extra inputs are not
# permitted" pydantic error from pydantic-settings.
LLM_PROVIDER=openai

# --- Real-world company discovery (optional) ---
# When both keys are set, the orchestrator runs a live Tavily + Firecrawl
# pipeline to source recently funded AI startups. Results are cached
# locally for DISCOVERY_CACHE_HOURS hours. If either key is missing
# or the live pipeline fails, the orchestrator falls back to the
# curated Demo Data set in backend/app/data/seed_companies.json.
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Discovery cache TTL in hours (default 24).
DISCOVERY_CACHE_HOURS=24

# Environment
ENVIRONMENT=development
DEBUG=true