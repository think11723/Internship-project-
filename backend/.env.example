# Project metadata (read by app.core.config.Settings)
PROJECT_NAME=FundFlow AI
PROJECT_DESCRIPTION=AI Career Intelligence Platform
VERSION=0.1.0

# API configuration
API_V1_PREFIX=/api

# CORS — origins allowed to call the API in development.
# In production, replace with the deployed frontend origin.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database — single SQLite file used for the Resume table.
DATABASE_URL=sqlite:///./fundflow.db

# --- AI Gateway (Sprint 9) ---
# All LLM calls route through app.services.ai_gateway with this
# fallback order: groq → openrouter → cerebras. Only ONE provider
# needs to succeed. Missing keys are silently skipped. If none are
# configured, the gateway returns None and the application falls
# back to deterministic output.
#
# Provider enable/disable (comma-separated; empty = all enabled).
#   LLM_PROVIDER_ORDER  = "groq,openrouter,cerebras"  (default)
#   LLM_PROVIDER_ENABLED = "groq,cerebras"           (example: disable openrouter)
LLM_PROVIDER_ORDER=groq,openrouter,cerebras
LLM_PROVIDER_ENABLED=

# Groq (primary — fast + free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter (fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Cerebras (final fallback)
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# --- Weekly discovery (RSS, no API keys needed) ---
# Weekly funding discovery now uses public RSS feeds
# (Google News + TechCrunch Startups + Hacker News) and the
# open-source Trafilatura / newspaper4k extractors. No external
# services required.
#
# The cache TTL still applies.
DISCOVERY_CACHE_HOURS=24

# --- Weekly Funding Agent ---
# When enabled, a background scheduler in main.py runs the agent every
# WEEKLY_AGENT_INTERVAL_HOURS, scraping the last WEEKLY_AGENT_LOOKBACK_DAYS
# days of funded AI startups into the discovery cache. Set RUN_ONCE=true in
# CI to trigger a synchronous refresh instead of starting the scheduler.
WEEKLY_AGENT_ENABLED=true
WEEKLY_AGENT_INTERVAL_HOURS=168
WEEKLY_AGENT_LOOKBACK_DAYS=7
WEEKLY_AGENT_RUN_ONCE=false

# Environment
ENVIRONMENT=development
DEBUG=true
